{
  "name": "4thestate-dashboard-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for the 4thestate investigation & editorial tracking dashboard",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"ts-node src/server.ts\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "create-user": "ts-node src/scripts/createUser.ts",
    "purge-audit-log": "ts-node src/scripts/purgeAuditLog.ts"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "google-auth-library": "^9.14.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.3",
    "otplib": "^13.5.0",
    "pdf-parse": "^1.1.4",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "tesseract.js": "^5.1.1",
    "tesseract.js-core": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.15",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
